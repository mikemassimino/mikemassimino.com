---
import { Image, Picture } from "astro:assets";

import BaseLayout from "../layouts/BaseLayout.astro";

import GradientButton from "../components/GradientButton.astro";
import OutlinedButton from "../components/OutlinedButton.astro";
import RocketAnimated from "../components/RocketAnimated.astro";
import InstagramWidget from "../components/InstagramWidget.astro";

import { Content as MeetMike } from "../meet_astro_mike.md";

const heroText = "Astronaut. Columbia Professor. Media Personality. Bestselling author. Explorer.";
const inspiringTalks =
  "Mike shares with audiences personal stories of inspiration, innovation, teamwork, and leadership as drawn from his experiences in one of the greatest and most dangerous jobs someone can have—NASA astronaut. Mike’s talks leave audiences feeling motivated and inspired to tackle their own challenges with determination, creativity, and a renewed sense of teamwork.";

const highlightedVideo = {
  title: "Astronaut Answers Questions from Twitter | Tech Support | Wired",
  url: "https://www.youtube.com/watch?v=YtIw3wqHeNY",
};

import highlightedVideoImg from "../assets/image 16.png";
import meetMikeImage from "../assets/mike/image 8.png";
import moonImage from "../assets/moon.svg";
import astroMike from "../assets/mike/spaceman_cutout.png";

import frequentGuestImg from "../assets/daily.jpg";
import tvMoviesImg from "../assets/bbt.jpg";

import spacemanCover from "../assets/books/cover2.jpg";
import moonshotCover from "../assets/books/moonshot_cover.png";

import changeHighlightedSpeakingImg from "../assets/highlighted_speaking/change.jpg";
import resilienceHighlightedSpeakingImg from "../assets/highlighted_speaking/resilience.jpg";
import teamworkHighlightedSpeakingImg from "../assets/highlighted_speaking/teamwork.jpg";

const speakingTopics = [
  {
    title: "On Teamwork and Leadership",
    description:
      "Individual accomplishments are needed, but the success of the team is most important. In our complex world, not everyone can be good at everything. But by pooling our abilities, we can be good at everything as a team.",
    image: teamworkHighlightedSpeakingImg,
    link: "https://vimeo.com/673764082",
  },
  {
    title: "Resilience in the Face of Adversity",
    description:
      "Sometimes forces out of our control can make moving forward difficult. In spite of our best efforts we often get knocked down repeatedly. But we need to find a way around that next obstacle. Mike encourages audiences: When the odds are against you, do it anyway.",
    image: resilienceHighlightedSpeakingImg,
    link: "https://vimeo.com/996710486",
  },
  {
    title: "Accepting Organizational & Technological Change",
    description:
      "In today’s spaceships, AI performs many of the decision making tasks previously done by astronauts. But the path getting there was not easy. Mike encourages audiences to embrace new technologies to give them the competitive edge they need in meeting the challenges of a dynamic and uncertain world.",
    image: changeHighlightedSpeakingImg,
    link: "https://vimeo.com/998000697",
  },
];
---

<BaseLayout pageTitle="Home" description="The personal website of astronaut and professor Mike Massimino.">
  <!-- Moon in the top bar -->
  <Image src={moonImage} alt="Moon." loading="eager" class="absolute right-0 top-0 z-10 h-auto w-32 lg:w-60" />

  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-hero-gradient bg-cover">
    <div class="mx-auto grid max-w-7xl grid-cols-1 items-end gap-y-6 px-6 pt-10 lg:grid-cols-12 lg:gap-x-8 lg:px-10 lg:pt-16">
      <!-- Copy column -->
      <div class="order-1 lg:order-2 lg:col-span-7 lg:col-start-6 lg:self-center lg:pb-24">
        <h1 class="font-jost text-[44px] leading-[1.05] tracking-tight text-white sm:text-6xl lg:text-7xl">Mike Massimino</h1>

        <p class="mt-5 max-w-xl font-exo text-lg leading-relaxed text-dimwhite sm:text-xl lg:mt-6 lg:text-2xl lg:leading-relaxed">
          {heroText}
        </p>

        <div class="mt-7 max-w-xs lg:mt-9">
          <GradientButton link="/speaking" text="SPEAKING INFORMATION" />
        </div>
      </div>

      <!-- Portrait column -->
      <div class="order-2 -mb-px flex justify-center lg:order-1 lg:col-span-5 lg:col-start-1 lg:justify-start">
        <Picture src={astroMike} alt="Mike Massimino in his NASA flight suit." loading="eager" class="w-full max-w-xs object-contain lg:max-w-md" width={600} />
      </div>
    </div>
  </section>

  <!-- Artemis II News Banner -->
  <a href="/media#artemis-ii" aria-label="Watch Mike's Artemis II mission coverage." class="group block bg-gradient-to-r from-[#0C48A8] to-[#1C1D1E]">
    <div class="mx-auto flex max-w-7xl flex-col items-center justify-center gap-2 px-6 py-4 text-center sm:flex-row sm:gap-4 sm:py-5 sm:text-left lg:px-10">
      <span class="flex-shrink-0 rounded-full bg-yellow px-3 py-1 font-exo text-xs font-bold uppercase tracking-wide text-black sm:text-sm">In the News</span>
      <p class="font-roboto text-base text-white sm:text-lg">
        Mike was on the air throughout NASA's <span class="font-bold">Artemis II</span> mission — launch, splashdown, and beyond.
      </p>
      <span class="whitespace-nowrap font-reddit text-sm font-light text-yellow underline underline-offset-4 group-hover:text-white sm:text-base">Watch the coverage &rarr;</span>
    </div>
  </a>

  <!-- Meet Astro Mike -->
  <section class="mx-auto max-w-7xl px-6 pb-16 pt-12 lg:px-10 lg:pb-24 lg:pt-20">
    <div class="grid grid-cols-1 gap-x-12 gap-y-8 lg:grid-cols-12 lg:items-start">
      <div class="lg:col-span-7">
        <h2 class="font-exo text-header text-red lg:text-5xl">Meet Astro Mike</h2>

        <div class="mt-5 space-y-4 font-roboto text-body leading-relaxed text-gray lg:mt-6 lg:text-base lg:leading-relaxed">
          <MeetMike />
        </div>

        <div class="mt-8 flex flex-col gap-4 sm:flex-row">
          <div class="sm:max-w-xs sm:flex-1"><GradientButton link="https://mikemassimino.paperform.co/" text="CONTACT MIKE" /></div>
          <div class="sm:max-w-xs sm:flex-1"><OutlinedButton link="/biography" text="FULL BIO" /></div>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:col-span-5 lg:grid-cols-1">
        <Picture src={meetMikeImage} alt="Mike Massimino speaking on stage." loading="lazy" class="w-full rounded-2xl object-cover shadow-lg" />

        <a href={highlightedVideo.url} target="_blank" rel="noopener noreferrer" class="group block self-start">
          <Image src={highlightedVideoImg} alt="Mike answering space questions on Wired." loading="lazy" class="w-full rounded-xl object-cover shadow-md" />
          <p class="mt-2 font-jost text-sm italic leading-snug text-gray group-hover:text-red">
            {highlightedVideo.title}
          </p>
        </a>
      </div>
    </div>
  </section>

  <div id="insta-trigger" class="h-1"></div>

  <!-- Content Cards -->
  <section class="bg-gradient-to-br from-[#7DCFFF] via-[#2E8FE7] to-[#091E3A] py-14 lg:py-20">
    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-8 px-6 md:grid-cols-3 lg:px-10">
      <!-- Books -->
      <article class="flex flex-col overflow-hidden rounded-3xl bg-gradient-to-b from-[#FDBE3D] to-[#E59447] shadow-lg">
        <div class="flex aspect-video items-center justify-center gap-3 overflow-hidden bg-gray2 p-4">
          <Image src={moonshotCover} alt="Cover of Moonshot." loading="lazy" class="max-h-full w-auto rounded-sm shadow-md" />
          <Image src={spacemanCover} alt="Cover of Spaceman." loading="lazy" class="max-h-full w-auto rounded-sm shadow-md" />
        </div>
        <div class="flex flex-1 flex-col p-5">
          <h3 class="font-jost text-xl font-medium text-white lg:text-2xl">New York Times Bestselling Author</h3>
          <p class="mt-2 flex-1 font-reddit font-light text-dimwhite">
            Mike is a New York Times Bestselling author. Check out his books: Moonshot, Spaceman, and Spaceman (Adapted for Young Readers).
          </p>
          <a
            href="/books"
            class="mt-5 flex h-11 items-center justify-center rounded-2xl bg-blue px-4 text-center font-reddit font-light text-white hover:bg-gray2"
          >
            Check out Mike's Books
          </a>
        </div>
      </article>

      <!-- TV & Movies -->
      <article class="flex flex-col overflow-hidden rounded-3xl bg-gradient-to-b from-[#0C48A8] to-[#1C1D1E] shadow-lg">
        <Image src={tvMoviesImg} loading="lazy" class="aspect-video w-full object-cover" alt="Mike's cameo on The Big Bang Theory." />
        <div class="flex flex-1 flex-col p-5">
          <h3 class="font-jost text-xl font-medium text-white lg:text-2xl">TV & Movies</h3>
          <p class="mt-2 flex-1 font-reddit font-light text-dimwhite">
            Mike has been featured in many hit shows, including The Big Bang Theory.
          </p>
          <a
            href="/media"
            class="mt-5 flex h-11 items-center justify-center rounded-2xl bg-gray px-4 text-center font-reddit font-light text-white hover:bg-gray2"
          >
            Watch Mike's Features
          </a>
        </div>
      </article>

      <!-- Frequent Guest -->
      <article class="flex flex-col overflow-hidden rounded-3xl bg-gradient-to-b from-[#0C48A8] to-[#1C1D1E] shadow-lg">
        <Image src={frequentGuestImg} loading="lazy" class="aspect-video w-full object-cover" alt="Mike being interviewed on The Daily Show." />
        <div class="flex flex-1 flex-col p-5">
          <h3 class="font-jost text-xl font-medium text-white lg:text-2xl">Frequent Guest</h3>
          <p class="mt-2 flex-1 font-reddit font-light text-dimwhite">
            Mike is a frequent guest and contributor to news programs, late-night TV, podcasts, and more.
          </p>
          <a
            href="/media"
            class="mt-5 flex h-11 items-center justify-center rounded-2xl bg-gray px-4 text-center font-reddit font-light text-white hover:bg-gray2"
          >
            See Mike on TV
          </a>
        </div>
      </article>
    </div>
  </section>

  <!-- Floating Instagram Widget (Desktop)
  <div class="relative hidden lg:mx-auto lg:max-w-7xl 2xl:block">
    <div class="absolute left-4 w-72">
      <div class="border-gray-200 sticky z-20 overflow-hidden rounded-2xl border bg-white shadow-xl">
        <div class="max-h-[calc(100vh-120px)] overflow-y-auto p-1">
          <InstagramWidget username="astromikemassimino" postCount={3} />
        </div>
      </div>
    </div>
  </div> -->

  <!-- Rocket transition -->
  <div id="rocket-transition" class="mx-auto hidden max-w-6xl px-10 py-4 lg:block" aria-hidden="true">
    <RocketAnimated />
  </div>

  <!-- Inspiring Talks Section -->
  <section class="bg-gradient-to-r from-[#EDF5FF] to-[#D7E6FF] py-14 lg:py-20">
    <div class="mx-auto max-w-7xl px-6 lg:px-10">
      <!-- Section intro -->
      <div class="lg:flex lg:items-end lg:justify-between lg:gap-12">
        <div class="lg:max-w-3xl">
          <h2 class="font-exo text-header text-red lg:text-5xl lg:leading-tight">Inspiring Talks from Space to Earth</h2>
          <p class="mt-4 font-roboto text-body leading-relaxed text-gray lg:mt-5 lg:text-lg lg:leading-relaxed">
            {inspiringTalks}
          </p>
        </div>
        <div class="mt-6 max-w-xs flex-shrink-0 lg:mt-0">
          <OutlinedButton link="/speaking" text="Watch Mike's highlights" />
        </div>
      </div>

      <!-- Speaking cards -->
      <div class="mt-10 grid grid-cols-1 gap-8 md:grid-cols-3 lg:mt-12">
        {
          speakingTopics.map((topic) => (
            <a href={topic.link} rel="noreferrer noopener" target="_blank" class="group flex flex-col overflow-hidden rounded-2xl shadow-lg">
              <Image src={topic.image} alt={`Mike speaking on ${topic.title}.`} loading="lazy" class="aspect-video w-full object-cover" width={500} />
              <div class="flex flex-1 flex-col bg-blue px-5 pb-6 pt-4">
                <h3 class="font-jost text-[20px] text-white group-hover:text-yellow">{topic.title}</h3>
                <p class="mt-2 font-roboto text-body leading-relaxed text-white">{topic.description}</p>
              </div>
            </a>
          ))
        }
      </div>

      <!-- CTA -->
      <div class="mt-12 flex flex-col items-center">
        <h3 class="text-center font-jost text-2xl text-red lg:text-3xl">Bring Mike’s Inspiring Stories to Your Event:</h3>
        <div class="mt-4 w-full max-w-xs">
          <GradientButton link="/speaking" text="SPEAKING INFORMATION" />
        </div>
      </div>
    </div>
  </section>

  <div class="lg:mx-auto lg:max-w-7xl">
    <!-- Mobile Instagram Widget (inline) -->
    <div class="mt-16 px-5 2xl:hidden">
      <InstagramWidget />
    </div>
  </div>

  <div id="floating-insta" class="pointer-events-none fixed bottom-4 left-4 z-50 hidden opacity-0 transition-opacity duration-500 2xl:block -translate-y-[240px]">
    <div class="border-gray-200 rounded-2xl border bg-white shadow-xl">
      <InstagramWidget username="astromikemassimino" postCount={3} />
    </div>
  </div>
</BaseLayout>

<script>
  // @ts-ignore
  import fsLightbox from "fslightbox";
  const trigger = document.getElementById("insta-trigger");
  const widget = document.getElementById("floating-insta");

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting && entry.boundingClientRect.top < 0) {
          // User has scrolled PAST the trigger point
          widget.classList.remove("opacity-0", "pointer-events-none");
          widget.classList.add("opacity-100");
        } else {
          // User is above the trigger point
          widget.classList.add("opacity-0", "pointer-events-none");
          widget.classList.remove("opacity-100");
        }
      });
    },
    { threshold: 0 },
  );

  observer.observe(trigger);
</script>
