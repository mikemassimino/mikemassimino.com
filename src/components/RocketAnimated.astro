---
/**
 * Scroll-driven ascent that bridges the dark media cards above and the pale
 * "Inspiring Talks" section below.
 *
 * Art direction follows Mike's book covers: a deep navy starfield, a small
 * realistic shuttle stack, a brilliant white plume cutting a long diagonal
 * (Moonshot), and a thin orbital arc behind it (Spaceman). Type is condensed
 * letterspaced caps, as on both jackets. Scrubbing the section flies the
 * stack up its plume while Mike's line resolves alongside it.
 */

const quote = "When the odds are against you, do it anyway.";
---

<section class="ascent" data-ascent aria-label="Mike's approach to the impossible">
  <div class="ascent__sky" aria-hidden="true">
    <div class="ascent__stars" data-stars-far></div>
    <div class="ascent__stars ascent__stars--near" data-stars-near></div>
  </div>

  <!-- Orbital arcs, borrowed from the Spaceman jacket. -->
  <svg class="ascent__arcs" data-arcs viewBox="0 0 1200 420" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <circle cx="240" cy="300" r="560" fill="none" stroke="#8FB6E8" stroke-width="1" opacity="0.22"></circle>
    <circle cx="980" cy="60" r="420" fill="none" stroke="#8FB6E8" stroke-width="1" opacity="0.16"></circle>
  </svg>

  <!-- Flight: plume and vehicle. -->
  <svg class="ascent__flight" viewBox="0 0 1200 420" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
    <defs>
      <linearGradient id="ascent-plume" x1="0" y1="1" x2="1" y2="0">
        <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0"></stop>
        <stop offset="25%" stop-color="#FFFFFF" stop-opacity="0.55"></stop>
        <stop offset="100%" stop-color="#FFFFFF" stop-opacity="1"></stop>
      </linearGradient>
      <filter id="ascent-bloom" x="-60%" y="-60%" width="220%" height="220%">
        <feGaussianBlur stdDeviation="7" result="b"></feGaussianBlur>
        <feMerge>
          <feMergeNode in="b"></feMergeNode>
          <feMergeNode in="SourceGraphic"></feMergeNode>
        </feMerge>
      </filter>
    </defs>

    <!-- The plume: soft halo under a hard bright core, as on the Moonshot jacket. -->
    <path
      id="ascent-path"
      data-plume-glow
      d="M96 414 C 300 386, 520 300, 700 208 S 1002 72, 1128 10"
      fill="none"
      stroke="url(#ascent-plume)"
      stroke-width="24"
      stroke-linecap="round"
      opacity="0.4"
      filter="url(#ascent-bloom)"></path>
    <path
      data-plume
      d="M96 414 C 300 386, 520 300, 700 208 S 1002 72, 1128 10"
      fill="none"
      stroke="url(#ascent-plume)"
      stroke-width="6.5"
      stroke-linecap="round"></path>

    <!-- Shuttle stack: external tank, twin SRBs, orbiter. Small and plausible
         rather than illustrative, matching the scale it has on the jackets. -->
    <g data-stack>
      <!-- Nose points along +X so autoRotate aligns it with the flight path.
           The stack is drawn at a small scale, so size it here in one place. -->
      <g transform="rotate(90) scale(1.85)">
        <!-- Exhaust at the base of the stack -->
        <g data-exhaust>
          <ellipse cx="0" cy="30" rx="7" ry="20" fill="#FFF3D0" opacity="0.95"></ellipse>
          <ellipse cx="0" cy="24" rx="3.4" ry="11" fill="#FFFFFF"></ellipse>
        </g>
        <!-- Solid rocket boosters -->
        <rect x="-9.4" y="-14" width="5.6" height="40" rx="2.8" fill="#EDEDED" stroke="#A8B0B8" stroke-width="0.4"></rect>
        <rect x="3.8" y="-14" width="5.6" height="40" rx="2.8" fill="#CFD3D7" stroke="#A8B0B8" stroke-width="0.4"></rect>
        <path d="M-9.4 -14 L-6.6 -24 L-3.8 -14 Z" fill="#EDEDED"></path>
        <path d="M3.8 -14 L6.6 -24 L9.4 -14 Z" fill="#CFD3D7"></path>
        <!-- External tank -->
        <path d="M0 -34 C 4.6 -26, 6 -12, 6 2 L 6 22 C 6 25, 3 26, 0 26 C -3 26, -6 25, -6 22 L -6 2 C -6 -12, -4.6 -26, 0 -34 Z" fill="#C8651F"></path>
        <path d="M2 -30 C 5.2 -22, 6 -10, 6 2 L 6 22 C 6 25, 3.6 26, 1.6 26 C 3.4 14, 4 -14, 2 -30 Z" fill="#A54E13"></path>
        <!-- Orbiter, tucked against the tank -->
        <g transform="translate(7.4 4)">
          <path
            d="M0 -16 C 2.6 -10, 3.4 0, 3.4 9 L 3.4 16 C 3.4 18, 1.8 19, 0 19 C -1.8 19, -3 18, -3 16 L -3 -2 C -3 -9, -2 -13, 0 -16 Z"
            fill="#F7F7F7"
            stroke="#9AA3AD"
            stroke-width="0.4"></path>
          <path d="M-3 10 L-9.5 20 L-3 18 Z" fill="#DCDFE3"></path>
          <path d="M3.4 10 L9.5 20 L3.4 18 Z" fill="#FFFFFF"></path>
          <!-- Heat-shield underside, the orbiter's one dark surface. -->
          <path d="M-3 -2 C -2.6 -9, -1.6 -13, 0 -16 C 0.7 -14, 1.2 -11, 1.5 -7 L -1.8 1 Z" fill="#3A3F45"></path>
          <!-- Flight-deck windows -->
          <path d="M-0.4 -11.6 L1.1 -9.2 L-0.9 -8.4 L-2 -10.6 Z" fill="#1B1F24"></path>
        </g>
      </g>
    </g>
  </svg>

  <!-- Mike's line, resolving as the stack climbs past it. -->
  <div class="ascent__copy">
    <p class="ascent__eyebrow" data-eyebrow>Mike Massimino</p>
    <blockquote class="ascent__quote" data-quote>{quote}</blockquote>
  </div>
</section>

<style>
  .ascent {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    height: clamp(300px, 34vw, 440px);
  }

  /* Resolves to the exact blue the section below opens on, so the two meet
     without a seam. */
  .ascent__sky {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, #050c2e 0%, #0a1c54 32%, #123a86 60%, #3f7fc6 82%, #a8c9ee 94%, #edf5ff 100%);
  }

  .ascent__stars,
  .ascent__stars--near {
    position: absolute;
    inset: -10% 0 28%;
    will-change: transform;
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 52%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 52%, transparent 100%);
  }

  .ascent__stars {
    background-image:
      radial-gradient(1.5px 1.5px at 11% 24%, #ffffff 50%, transparent 52%),
      radial-gradient(1.3px 1.3px at 26% 61%, #d7e4ff 50%, transparent 52%),
      radial-gradient(1.7px 1.7px at 44% 13%, #ffffff 50%, transparent 52%),
      radial-gradient(1.2px 1.2px at 61% 46%, #c9dcff 50%, transparent 52%),
      radial-gradient(1.6px 1.6px at 79% 27%, #ffffff 50%, transparent 52%),
      radial-gradient(1.3px 1.3px at 91% 64%, #e2ebff 50%, transparent 52%),
      radial-gradient(1.4px 1.4px at 6% 74%, #ffffff 50%, transparent 52%),
      radial-gradient(1.2px 1.2px at 35% 37%, #ffffff 50%, transparent 52%);
    opacity: 0.8;
  }

  .ascent__stars--near {
    background-image:
      radial-gradient(2.4px 2.4px at 19% 33%, #ffffff 50%, transparent 52%),
      radial-gradient(2px 2px at 54% 22%, #fff1c8 50%, transparent 52%),
      radial-gradient(2.2px 2.2px at 73% 54%, #ffffff 50%, transparent 52%),
      radial-gradient(1.9px 1.9px at 34% 70%, #ffffff 50%, transparent 52%),
      radial-gradient(2.3px 2.3px at 87% 17%, #fff1c8 50%, transparent 52%);
    opacity: 0.9;
  }

  .ascent__arcs,
  .ascent__flight {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .ascent__arcs {
    will-change: transform;
  }

  [data-stack] {
    will-change: transform;
  }

  /* Copy sits in the dark upper-left, clear of the plume's diagonal. */
  .ascent__copy {
    position: absolute;
    left: clamp(1.5rem, 7vw, 8rem);
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    max-width: min(30rem, 52%);
  }

  .ascent__eyebrow {
    margin: 0 0 0.75rem;
    font-family: "Exo 2 Variable", sans-serif;
    font-size: clamp(0.6rem, 0.9vw, 0.72rem);
    font-weight: 700;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: #f0cb78;
  }

  .ascent__quote {
    margin: 0;
    font-family: "Jost Variable", sans-serif;
    font-size: clamp(1.25rem, 2.6vw, 2.1rem);
    font-weight: 400;
    line-height: 1.22;
    letter-spacing: 0.01em;
    color: #ffffff;
    text-wrap: balance;
    /* Keeps the line legible where the plume passes close behind it. */
    text-shadow: 0 2px 18px rgba(3, 10, 38, 0.55);
  }

  /* On narrow screens the flight path crosses the copy, so lift the text into
     the dark upper band and let the vehicle climb clear beneath it. The band
     is kept tight to the copy so the scene never reads as empty space. */
  @media (max-width: 760px) {
    .ascent {
      height: clamp(252px, 56vw, 300px);
    }

    .ascent__copy {
      left: 1.25rem;
      top: 1.5rem;
      transform: none;
      max-width: calc(100% - 2.5rem);
    }

    .ascent__eyebrow {
      margin-bottom: 0.4rem;
      font-size: 0.68rem;
      letter-spacing: 0.26em;
    }

    .ascent__quote {
      font-size: clamp(1.45rem, 6.4vw, 1.95rem);
      line-height: 1.16;
    }

    /* Hold the flight below the copy block so the nose never crowds the text. */
    .ascent__flight {
      top: 34%;
      height: 66%;
    }
  }

  /* Without scroll-linked motion the scene must still read as finished. */
  @media (prefers-reduced-motion: reduce) {
    .ascent__copy {
      opacity: 1 !important;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { MotionPathPlugin } from "gsap/MotionPathPlugin";

  gsap.registerPlugin(ScrollTrigger, MotionPathPlugin);

  const scene = document.querySelector<HTMLElement>("[data-ascent]");

  if (scene) {
    const stack = scene.querySelector<SVGGElement>("[data-stack]");
    const path = scene.querySelector<SVGPathElement>("#ascent-path");
    const plume = scene.querySelector<SVGPathElement>("[data-plume]");
    const plumeGlow = scene.querySelector<SVGPathElement>("[data-plume-glow]");
    const exhaust = scene.querySelector<SVGGElement>("[data-exhaust]");
    const arcs = scene.querySelector<SVGElement>("[data-arcs]");
    const starsFar = scene.querySelector<HTMLElement>("[data-stars-far]");
    const starsNear = scene.querySelector<HTMLElement>("[data-stars-near]");
    const eyebrow = scene.querySelector<HTMLElement>("[data-eyebrow]");
    const quote = scene.querySelector<HTMLElement>("[data-quote]");

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const plumes = [plume, plumeGlow].filter(Boolean) as SVGPathElement[];
    const lengths = new Map(plumes.map((p) => [p, p.getTotalLength()]));

    if (reduced) {
      // Show the completed ascent, with no scroll-linked movement.
      plumes.forEach((p) => gsap.set(p, { strokeDasharray: lengths.get(p), strokeDashoffset: 0 }));
      if (stack && path) {
        // Park it at the end of the track, angled along the final heading.
        const total = path.getTotalLength();
        const end = path.getPointAtLength(total);
        const prev = path.getPointAtLength(total - 1);
        const heading = (Math.atan2(end.y - prev.y, end.x - prev.x) * 180) / Math.PI;
        gsap.set(stack, { x: end.x, y: end.y, rotation: heading, scale: 0.78, transformOrigin: "50% 50%" });
      }
    } else {
      plumes.forEach((p) => {
        const len = lengths.get(p)!;
        gsap.set(p, { strokeDasharray: len, strokeDashoffset: len });
      });

      if (stack && path) {
        const start = path.getPointAtLength(0);
        gsap.set(stack, { x: start.x, y: start.y, transformOrigin: "50% 50%" });
      }

      // The engines flicker continuously; this is the one loop that is not
      // tied to scroll, so the vehicle never looks switched off mid-climb.
      if (exhaust) {
        gsap.to(exhaust, {
          scaleY: 1.22,
          scaleX: 0.86,
          opacity: 0.82,
          duration: 0.09,
          repeat: -1,
          yoyo: true,
          ease: "none",
          transformOrigin: "50% 0%",
        });
      }

      const tl = gsap.timeline({
        defaults: { ease: "none" },
        scrollTrigger: { trigger: scene, start: "top bottom", end: "bottom top", scrub: 0.8 },
      });

      // Ascent: the stack rides the plume and shrinks with distance.
      if (stack && path) {
        tl.to(
          stack,
          {
            motionPath: { path, align: path, alignOrigin: [0.5, 0.5], autoRotate: true, start: 0, end: 1 },
            duration: 1,
          },
          0,
        ).fromTo(stack, { scale: 1.15, transformOrigin: "50% 50%" }, { scale: 0.78, duration: 1 }, 0);
      }

      plumes.forEach((p) => tl.to(p, { strokeDashoffset: 0, duration: 1 }, 0));

      // Mike's line resolves early in the scrub and holds while the stack climbs.
      if (eyebrow) tl.fromTo(eyebrow, { opacity: 0, y: 14 }, { opacity: 1, y: 0, duration: 0.22, ease: "power2.out" }, 0.08);
      if (quote) tl.fromTo(quote, { opacity: 0, y: 24 }, { opacity: 1, y: 0, duration: 0.3, ease: "power2.out" }, 0.14);

      // Parallax, slowest field furthest away.
      if (arcs) tl.to(arcs, { yPercent: 12, duration: 1 }, 0);
      if (starsNear) tl.to(starsNear, { yPercent: 15, duration: 1 }, 0);
      if (starsFar) tl.to(starsFar, { yPercent: 6, duration: 1 }, 0);
    }
  }
</script>
